---
/**
 * Ön bilgilendirme asistanı — sohbet paneli.
 * - Konu düğmeleriyle başlangıç, sayfaya göre öneri
 * - Akan yanıt (POST /api/asistan, stream: true)
 * - Süreli işlem uyarısı (tarayıcıda anahtar kelimeyle)
 * - Sabit görüşme düğmeleri ve "Talep özeti" kartı ([[TALEP|...]] satırından)
 * Mesajlar yalnızca sayfa açıkken bellekte tutulur; hiçbir yerde saklanmaz.
 */
import { contactChannels, mailHref } from '../config/contact';
import { site } from '../config/site';

const { topics, pageSuggestions, urgentPattern } = contactChannels.asistan;
const wa = contactChannels.whatsapp;
const config = {
  wa: wa.enabled ? wa.number : '',
  tel: site.phone.href,
  phone: site.phone.display,
  email: site.email,
  mail: mailHref,
  pageSuggestions,
  urgentPattern,
};
---

<div class="asistan pointer-events-none flex w-full flex-col items-end sm:w-auto" data-asistan>
  <script type="application/json" data-config set:html={JSON.stringify(config)} />

  <section
    id="asistan-panel"
    class="pointer-events-auto hidden h-[min(640px,calc(100svh-5rem))] w-full flex-col border-t border-ink bg-bone sm:mb-3 sm:w-[400px] sm:border"
    role="dialog"
    aria-modal="false"
    aria-labelledby="asistan-baslik"
    data-panel
  >
    <header class="flex items-start justify-between gap-4 border-b border-rule px-5 py-4">
      <div>
        <h2 id="asistan-baslik" class="font-serif text-xl leading-tight">Akbulut Asistan</h2>
        <p class="mt-1 text-xs text-slate">Genel bilgi verir; hukuki görüş yerine geçmez.</p>
      </div>
      <button type="button" class="-mr-1 p-1 text-sm text-slate hover:text-ink" data-close aria-label="Asistanı kapat">
        Kapat
      </button>
    </header>

    <!-- Süreli işlem uyarısı -->
    <div class="hidden border-b border-rule bg-paper px-5 py-3" data-urgent role="status">
      <p class="text-sm text-ink">
        Süreli bir işlemden söz ediyorsunuz. Yasal süreler kısa olabilir; telefonla doğrudan ulaşmanız uygun olur.
      </p>
      <a href={site.phone.href} class="mt-2 inline-block text-sm font-medium text-navy underline underline-offset-4">
        {site.phone.display} numarasını arayın
      </a>
    </div>

    <div class="flex-1 space-y-4 overflow-y-auto px-5 py-5 text-[0.9375rem] leading-relaxed" data-log aria-live="polite">
      <div class="msg-bot">
        <p>Merhaba. Konunuzu seçin ya da kısaca yazın; hangi çalışma alanına girdiğini ve büromuza nasıl ulaşabileceğinizi belirteyim.</p>
      </div>
      <div data-start>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            topics.map((t) => (
              <button
                type="button"
                class="border border-rule bg-paper px-3 py-2.5 text-left text-sm text-ink transition-colors duration-150 hover:border-ink"
                data-topic={t.label}
                data-message={t.message}
              >
                {t.label}
              </button>
            ))
          }
        </div>
        <button
          type="button"
          class="mt-3 hidden w-full border border-rule px-3 py-2.5 text-left text-sm text-slate transition-colors duration-150 hover:border-ink hover:text-ink"
          data-page-suggestion
        ></button>
      </div>
    </div>

    <!-- Sabit görüşme düğmeleri (ilk yanıttan sonra görünür) -->
    <div class="hidden gap-2 border-t border-rule px-5 pt-3" data-actions>
      {
        config.wa && (
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-navy px-3 py-2.5 text-center text-sm font-medium text-bone transition-colors duration-150 hover:bg-ink"
            data-wa-link
          >
            WhatsApp ile devam et
          </a>
        )
      }
      <a
        href={site.phone.href}
        class="flex-1 border border-ink/30 px-3 py-2.5 text-center text-sm font-medium text-ink transition-colors duration-150 hover:border-ink"
      >
        Ara
      </a>
    </div>

    <form class="px-5 pt-3 pb-4" data-form>
      <label for="asistan-girdi" class="sr-only">Mesajınız</label>
      <div class="flex items-end gap-3">
        <textarea
          id="asistan-girdi"
          rows="2"
          maxlength="1200"
          placeholder="Konunuzu kısaca yazın"
          class="min-h-[2.75rem] flex-1 resize-none border border-rule bg-paper px-3 py-2 text-[0.9375rem] text-ink placeholder:text-slate/70 focus:border-navy focus:outline-none"
          data-input></textarea>
        <button
          type="submit"
          class="bg-navy px-4 py-3 text-sm font-medium text-bone transition-colors duration-150 hover:bg-ink disabled:opacity-50"
          data-send
        >
          Gönder
        </button>
      </div>
      <p class="mt-3 text-[0.6875rem] leading-snug text-slate">
        Kimlik numarası, sağlık bilgisi veya belge paylaşmayın. Konuşmalar kaydedilmez.
        <a href="/kvkk" class="underline underline-offset-2 hover:text-ink">KVKK</a>
      </p>
    </form>
  </section>

  <button
    type="button"
    class="pointer-events-auto m-4 bg-navy px-5 py-3.5 text-sm font-medium text-bone transition-colors duration-150 hover:bg-ink sm:m-0"
    aria-expanded="false"
    aria-controls="asistan-panel"
    data-toggle
  >
    <span data-toggle-label>Akbulut Asistan</span>
  </button>
</div>

<style>
  .asistan :global(.msg-bot) {
    color: var(--color-ink);
    max-width: 94%;
  }
  .asistan :global(.msg-bot > * + *) {
    margin-top: 0.5rem;
  }
  .asistan :global(.msg-user) {
    margin-left: auto;
    max-width: 85%;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    padding: 0.5rem 0.75rem;
    white-space: pre-wrap;
  }
  .asistan :global(.msg-bot ul) {
    list-style: square;
    padding-left: 1.25rem;
  }
  .asistan :global(.msg-bot li::marker) {
    color: var(--color-bronze);
  }
  .asistan :global(.msg-error) {
    color: #8a2c1d;
    font-size: 0.875rem;
  }
  .asistan :global(.msg-wait) {
    color: var(--color-slate);
    font-size: 0.875rem;
  }
  @media (max-width: 639px) {
    .asistan [data-panel]:not(.hidden) ~ [data-toggle] {
      display: none;
    }
  }
</style>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  type Talep = { alan: string; sureli: boolean; mesaj: string };
  type Config = {
    wa: string;
    tel: string;
    phone: string;
    email: string;
    mail: string;
    pageSuggestions: Record<string, string>;
    urgentPattern: string;
  };

  const root = document.querySelector<HTMLElement>('[data-asistan]');
  if (root) {
    const cfg: Config = JSON.parse(root.querySelector('[data-config]')!.textContent || '{}');
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const panel = $('[data-panel]');
    const toggle = $<HTMLButtonElement>('[data-toggle]');
    const toggleLabel = $('[data-toggle-label]');
    const log = $('[data-log]');
    const form = $<HTMLFormElement>('[data-form]');
    const input = $<HTMLTextAreaElement>('[data-input]');
    const send = $<HTMLButtonElement>('[data-send]');
    const start = root.querySelector<HTMLElement>('[data-start]');
    const actions = $('[data-actions]');
    const waLink = root.querySelector<HTMLAnchorElement>('[data-wa-link]');
    const urgent = $('[data-urgent]');
    const pageBtn = root.querySelector<HTMLButtonElement>('[data-page-suggestion]');
    const urgentRe = new RegExp(cfg.urgentPattern, 'i');

    const history: Msg[] = [];
    let busy = false;
    let topicLabel = '';
    let talep: Talep | null = null;

    // ── Aç / kapat ─────────────────────────────────────────────
    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      panel.classList.toggle('flex', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggleLabel.textContent = open ? 'Kapat' : 'Akbulut Asistan';
      if (open) input.focus();
      else toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
    $('[data-close]').addEventListener('click', () => setOpen(false));
    // Sayfadaki diğer "Ön bilgilendirme" düğmeleri paneli açar
    document.querySelectorAll<HTMLElement>('[data-open-asistan]').forEach((b) =>
      b.addEventListener('click', () => setOpen(true)),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) setOpen(false);
    });

    // ── Sayfaya göre öneri ─────────────────────────────────────
    const path = location.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
    const articleTitle = document.querySelector('article h1')?.textContent?.trim() || '';
    const pageKey = Object.keys(cfg.pageSuggestions).find((k) => (k.endsWith('/') ? path.startsWith(k) : path === k));
    if (pageBtn && pageKey) {
      const text = cfg.pageSuggestions[pageKey].replace('{baslik}', articleTitle);
      if (!pageKey.endsWith('/') || articleTitle) {
        pageBtn.textContent = text;
        pageBtn.classList.remove('hidden');
        pageBtn.addEventListener('click', () => ask(text));
      }
    }

    // ── Yardımcılar ────────────────────────────────────────────
    const escape = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const TAG = /\[\[TALEP\|([^\]]*)\]\]/;
    /** Görüntülenecek metin: talep satırını ve akış sırasında yarım kalan "[[" parçasını gizler. */
    const visible = (text: string) => text.replace(TAG, '').replace(/\[\[[^\]]*$/, '').trim();

    const parseTalep = (text: string): Talep | null => {
      const m = text.match(TAG);
      if (!m) return null;
      const fields = Object.fromEntries(
        m[1].split('|').map((kv) => {
          const i = kv.indexOf('=');
          return [kv.slice(0, i).trim(), kv.slice(i + 1).trim()];
        }),
      );
      const mesaj = (fields.mesaj || '').replace(/^["“]|["”]$/g, '');
      if (!mesaj) return null;
      return { alan: fields.alan || 'Genel', sureli: /^evet/i.test(fields.sureli || ''), mesaj };
    };

    /** Güvenli, sınırlı biçimlendirme: **kalın**, "- " listeleri, paragraflar. */
    const render = (text: string) => {
      let html = '';
      let inList = false;
      for (const raw of text.split('\n')) {
        const line = escape(raw).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        const m = line.match(/^\s*[-*•]\s+(.*)$/);
        if (m) {
          if (!inList) (html += '<ul>'), (inList = true);
          html += `<li>${m[1]}</li>`;
        } else {
          if (inList) (html += '</ul>'), (inList = false);
          if (line.trim()) html += `<p>${line}</p>`;
        }
      }
      if (inList) html += '</ul>';
      return html;
    };

    const add = (cls: string, html: string) => {
      const el = document.createElement('div');
      el.className = cls;
      el.innerHTML = html;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };

    const waText = () =>
      talep?.mesaj ||
      (topicLabel && topicLabel !== 'Diğer'
        ?`Merhaba, ${topicLabel.toLocaleLowerCase('tr-TR')} konusunda görüşme talebinde bulunmak istiyorum.`
        : 'Merhaba, site üzerinden ön bilgi aldım; görüşme talebinde bulunmak istiyorum.');
    const waUrl = (text: string) => `https://wa.me/${cfg.wa}?text=${encodeURIComponent(text)}`;

    const showActions = () => {
      actions.classList.remove('hidden');
      actions.classList.add('flex');
      if (waLink) waLink.href = waUrl(waText());
    };

    const showUrgent = () => urgent.classList.remove('hidden');

    /** "Talep özeti" kartı */
    const talepCard = (t: Talep) => {
      const mailto = `mailto:${cfg.email}?subject=${encodeURIComponent(`Görüşme talebi — ${t.alan}`)}&body=${encodeURIComponent(t.mesaj)}`;
      const btn =
        'inline-block px-3 py-2 text-xs font-medium transition-colors duration-150';
      return `<div class="border border-ink bg-paper p-4">
        <p class="font-serif text-lg leading-tight">Talep özetiniz</p>
        <dl class="mt-3 space-y-1 text-sm">
          <div class="flex gap-2"><dt class="text-slate">Alan:</dt><dd>${escape(t.alan)}</dd></div>
          ${t.sureli ? '<div class="flex gap-2"><dt class="text-slate">Süreli işlem:</dt><dd>Evet, telefonla ulaşmanız önerilir</dd></div>' : ''}
        </dl>
        <p class="mt-3 border-l border-bronze pl-3 text-sm text-ink">${escape(t.mesaj)}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          ${
            t.sureli
              ? `<a href="${cfg.tel}" class="${btn} bg-navy text-bone hover:bg-ink">Ara</a>`
              : ''
          }
          ${
            cfg.wa
              ? `<a href="${waUrl(t.mesaj)}" target="_blank" rel="noopener noreferrer" class="${btn} ${t.sureli ? 'border border-ink/30 text-ink hover:border-ink' : 'bg-navy text-bone hover:bg-ink'}">WhatsApp'ta gönder</a>`
              : ''
          }
          ${t.sureli ? '' : `<a href="${cfg.tel}" class="${btn} border border-ink/30 text-ink hover:border-ink">Ara</a>`}
          <a href="${mailto}" class="${btn} border border-ink/30 text-ink hover:border-ink">E-posta</a>
        </div>
      </div>`;
    };

    // ── Gönder / akış ──────────────────────────────────────────
    const ask = async (text: string) => {
      const content = text.trim();
      if (!content || busy) return;
      busy = true;
      send.disabled = true;
      start?.remove();
      if (urgentRe.test(content.toLocaleLowerCase('tr-TR'))) showUrgent();

      history.push({ role: 'user', content });
      add('msg-user', escape(content));
      input.value = '';
      const bot = add('msg-wait', 'Yanıt hazırlanıyor…');
      let full = '';

      try {
        const res = await fetch('/api/asistan', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            messages: history,
            stream: true,
            page: { path, title: document.title },
          }),
        });

        if (!res.ok || !res.body || !(res.headers.get('content-type') || '').startsWith('text/plain')) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || 'Asistan şu anda yanıt veremiyor. Telefon veya e-posta ile ulaşabilirsiniz.');
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        bot.className = 'msg-bot';
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          full += decoder.decode(value, { stream: true });
          bot.innerHTML = render(visible(full));
          log.scrollTop = log.scrollHeight;
        }
        full += decoder.decode();
        if (!visible(full)) throw new Error('Yanıt üretilemedi. Lütfen tekrar deneyin.');

        bot.innerHTML = render(visible(full));
        history.push({ role: 'assistant', content: full.trim() });

        const t = parseTalep(full);
        if (t && !talep) {
          talep = t;
          add('', talepCard(t));
          if (t.sureli) showUrgent();
        }
        showActions();
      } catch (err) {
        bot.remove();
        history.pop();
        add('msg-error', escape((err as Error).message || 'Bağlantı kurulamadı. Lütfen tekrar deneyin.'));
      } finally {
        busy = false;
        send.disabled = false;
        input.focus();
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        ask(input.value);
      }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b) =>
      b.addEventListener('click', () => {
        topicLabel = b.dataset.topic || '';
        ask(b.dataset.message || b.textContent || '');
      }),
    );
  }
</script>
