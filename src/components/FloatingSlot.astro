---
/**
 * Sağ alt köşe ayrılmış alanı — ön bilgilendirme asistanı burada yaşar.
 * Sarmalayıcı tıklamaları geçirir (pointer-events: none); içerik kendi tıklamalarını alır.
 * Katman: var(--z-floating). Sitedeki başka hiçbir öğe bu köşeye konumlandırılmamalıdır.
 */
import { contactChannels } from '../config/contact';
import Asistan from './Asistan.astro';
---

<div
  id="floating-slot"
  class="pointer-events-none fixed right-0 bottom-0 left-0 sm:left-auto z-(--z-floating) flex flex-col items-end sm:right-6 sm:bottom-6"
>
  {contactChannels.asistan.enabled && <Asistan />}
</div>
