---
/**
 * Görüşme talebi alanı: düğmeler + (açıksa) konuya göre WhatsApp + (açıksa) Cal.com.
 * Kanallar `src/config/contact.ts` içinden açılıp kapatılır.
 */
import { contactChannels } from '../../config/contact';
import GorusmeButonlari from './GorusmeButonlari.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import CalEmbed from './CalEmbed.astro';

const { whatsapp, calcom } = contactChannels;
---

<section id="gorusme-talebi" class="scroll-mt-28" aria-labelledby="gorusme-talebi-baslik">
  <h2 id="gorusme-talebi-baslik" class="h2">Görüşme talebi</h2>
  <p class="mt-4 max-w-xl text-slate">
    Konunuzu kısaca iletmeniz yeterlidir; ön bilgi ve çıkar çatışması kontrolünün ardından size randevu için dönüş
    yapılır.
  </p>
  <div class="mt-8">
    <GorusmeButonlari />
  </div>
  {
    whatsapp.enabled && whatsapp.number && (
      <div class="mt-12">
        <WhatsAppLink />
      </div>
    )
  }
  {
    calcom.enabled && calcom.calLink && (
      <div class="mt-12">
        <CalEmbed />
      </div>
    )
  }
</section>
