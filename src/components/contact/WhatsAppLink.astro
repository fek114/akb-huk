---
import { contactChannels, waHref } from '../../config/contact';
const { number, topics } = contactChannels.whatsapp;
---

<ul class="border-t border-rule">
  {
    topics.map((topic) => (
      <li class="border-b border-rule">
        <a
          href={waHref(number, topic)}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between gap-6 py-4 text-sm text-ink hover:text-navy"
        >
          <span>{topic}</span>
          <span class="label text-slate">WhatsApp ↗</span>
        </a>
      </li>
    ))
  }
</ul>
