---
import { calismaAlanlari } from '../data/calisma-alanlari';
---

<ol class="border-t border-ink">
  {
    calismaAlanlari.map((alan) => (
      <li class="border-b border-rule">
        <a
          href={`/calisma-alanlari#${alan.id}`}
          class="group grid grid-cols-[3rem_1fr] items-baseline gap-4 py-7 md:grid-cols-[5rem_1fr] md:py-9"
        >
          <span class="font-sans text-sm text-bronze tabular-nums">{alan.no}</span>
          <span class="font-serif text-[1.5rem] leading-snug tracking-(--tracking-display) text-ink decoration-rule decoration-1 underline-offset-[6px] transition-colors duration-150 group-hover:text-navy group-hover:underline md:text-[2rem]">
            {alan.title}
          </span>
        </a>
      </li>
    ))
  }
</ol>
