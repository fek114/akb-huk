---
/**
 * İlk görüşme süreci. Gerçek bir sıra olduğu için numaralıdır.
 * Ücret cümlesi TBB Avukatlık Asgari Ücret Tarifesi'ne atıf yapar; tutar veya indirim içermez.
 */
import { site } from '../config/site';

interface Props {
  /** Başlık seviyesi: sayfa içindeki yerine göre */
  headingId?: string;
}
const { headingId = 'gorusme-sureci' } = Astro.props;

const adimlar = [
  {
    title: 'Ön bilgi',
    text: `Telefon veya e-posta ile konunuzu kısaca iletirsiniz. Karşı tarafın adını alarak çıkar çatışması kontrolü yaparız; bu aşamada belge göndermenize gerek yoktur.`,
  },
  {
    title: 'Randevu',
    text: `Uygun olduğumuzu teyit ettikten sonra, ilgili avukatla büromuzda bir görüşme planlanır.`,
  },
  {
    title: 'Değerlendirme ve ücret sözleşmesi',
    text: `Görüşmede hukuki durumunuz, izlenebilecek yollar ve öngörülen süreç açıklanır. Hizmet kararlaştırılırsa kapsam ve ücret yazılı bir sözleşmeyle belirlenir.`,
  },
];
---

<section aria-labelledby={headingId}>
  <h2 id={headingId} class="h2">İlk görüşme nasıl işler?</h2>
  <ol class="mt-10 border-t border-ink">
    {
      adimlar.map((adim, i) => (
        <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-rule py-8">
          <span class="font-serif text-2xl leading-none text-bronze tabular-nums">{i + 1}</span>
          <div>
            <h3 class="font-serif text-[1.375rem] leading-snug">{adim.title}</h3>
            <p class="mt-3 max-w-xl text-slate">{adim.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="mt-8 max-w-xl text-sm text-slate">
    Avukatlık ücretleri, Türkiye Barolar Birliği Avukatlık Asgari Ücret Tarifesi esas alınarak işin kapsamına göre
    belirlenir ve yazılı sözleşmeyle kayıt altına alınır. Randevu için
    <a href={site.phone.href} class="link whitespace-nowrap">{site.phone.display}</a> veya
    <a href={`mailto:${site.email}`} class="link">{site.email}</a>.
  </p>
</section>
