---
import { formatDate, type Yayin } from '../lib/yayinlar';
import { avukatBul } from '../data/kadro';

interface Props {
  items: Yayin[];
}
const { items } = Astro.props;
---

<ul class="border-t border-ink">
  {
    items.map((y) => (
      <li class="border-b border-rule">
        <a
          href={`/yayinlar/${y.id}`}
          class="group grid grid-cols-1 gap-3 py-8 md:grid-cols-12 md:gap-8 md:py-10"
        >
          <div class="flex gap-4 text-sm text-slate md:col-span-3 md:flex-col md:gap-1">
            <time datetime={y.data.date.toISOString()}>{formatDate(y.data.date)}</time>
            <span class="label">{y.data.category}</span>
          </div>
          <div class="md:col-span-8 md:col-start-5">
            <h3 class="font-serif text-[1.625rem] leading-snug tracking-(--tracking-display) transition-colors duration-150 group-hover:text-navy">
              {y.data.title}
            </h3>
            <p class="mt-3 max-w-2xl text-slate">{y.data.description}</p>
            {avukatBul(y.data.author) && (
              <p class="mt-4 text-sm text-ink">Av. {avukatBul(y.data.author)!.ad}</p>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>
