---
/**
 * Editoryal fotoğraf bileşeni.
 * Tüm fotoğraflar tek bir görsel dilde sunulur: siyah-beyaz, hafif kontrast, köşesiz, gölgesiz.
 * Astro, kaynak görselden AVIF/WebP ve çoklu genişlikte sürümler üretir.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Tailwind aspect sınıfları, örn. "aspect-[4/5]" veya "aspect-[4/3] md:aspect-[21/9]" */
  aspect?: string;
  /** CSS object-position, örn. "50% 30%" */
  position?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  aspect = 'aspect-[4/3]',
  position = '50% 50%',
  sizes = '(min-width: 768px) 50vw, 100vw',
  widths = [480, 800, 1200, 1600, 2400],
  priority = false,
  class: className,
} = Astro.props;
---

<figure class:list={['photo', className]}>
  <div class:list={['overflow-hidden bg-rule', aspect]}>
    <Image
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="h-full w-full object-cover"
      style={`object-position: ${position}`}
    />
  </div>
  {caption && <figcaption class="mt-3 text-xs text-slate">{caption}</figcaption>}
</figure>

<style>
  .photo img {
    filter: grayscale(1) contrast(1.06) brightness(0.98);
  }
</style>
