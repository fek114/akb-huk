---
import Layout from '../layouts/Layout.astro';
import PracticeIndex from '../components/PracticeIndex.astro';
import { site } from '../config/site';
import Photo from '../components/Photo.astro';
import GorusmeSureci from '../components/GorusmeSureci.astro';
import GorusmeButonlari from '../components/contact/GorusmeButonlari.astro';
import bursaUludag from '../assets/images/bursa-uludag.jpg';
import betonCephe from '../assets/images/beton-cephe.jpg';
---

<Layout>
  <!-- Giriş -->
  <section>
    <div class="wrap grid grid-cols-1 gap-10 pt-20 pb-16 md:grid-cols-12 md:pt-32 md:pb-24">
      <p class="label md:col-span-12">Bursa · 1996'dan Bugüne</p>
      <h1 class="display md:col-span-10">
        Otuz Yıllık Kurumsal Hafıza, Öngörülebilir Hukuki Çözümler.
      </h1>
      <p class="lead md:col-span-6 md:col-start-6">
        Akbulut Hukuk Bürosu; Bursa ve Türkiye genelinde faaliyet gösteren yerli ve uluslararası şirketlere,
        kurumsal yönetim, ticari sözleşmeler ve uyuşmazlık çözümü alanlarında otuz yılı aşkın mesleki birikimle
        hukuki danışmanlık ve temsil hizmeti sunmaktadır.
      </p>
    </div>

    <!-- Editoryal manşet fotoğrafı: Bursa ve Uludağ -->
    <div class="wrap pb-24 md:pb-32">
      <Photo
        src={bursaUludag}
        alt="Bursa kent merkezi ve arka planda bulutların altında Uludağ"
        caption="Bursa · Uludağ eteklerinden kente bakış"
        aspect="aspect-[4/3] md:aspect-[21/9]"
        position="40% 62%"
        sizes="(min-width: 1360px) 1264px, 100vw"
        priority
      />
    </div>
  </section>

  <!-- Kimler için -->
  <section class="border-t border-rule" aria-labelledby="kimler">
    <div class="wrap grid grid-cols-1 gap-10 py-20 md:grid-cols-12 md:py-24">
      <h2 id="kimler" class="h2 md:col-span-4">Kimlerle çalışıyoruz</h2>
      <div class="md:col-span-7 md:col-start-6">
        <ul class="grid grid-cols-1 border-t border-rule sm:grid-cols-2">
          {
            [
              'Sanayi ve üretim işletmeleri',
              'Ticaret ve hizmet şirketleri',
              'İşverenler ve insan kaynakları birimleri',
              'Aile şirketleri ve şirket ortakları',
            ].map((item) => (
              <li class="border-b border-rule py-4 text-lg sm:odd:pr-6">{item}</li>
            ))
          }
        </ul>
        <p class="mt-8 max-w-xl text-slate">
          Sözleşme hazırlığından iş hukukuna, şirket işlemlerinden ticari uyuşmazlıklara kadar işletmelerin günlük
          hukuki ihtiyaçlarına danışmanlık veriyor, gerektiğinde mahkeme ve tahkimde temsil ediyoruz. Başvurunuzun
          çalışma alanlarımız kapsamında olup olmadığını ön bilgi aşamasında açıkça belirtiriz.
        </p>
      </div>
    </div>
  </section>

  <!-- Kurumsal Yaklaşım Bandı -->
  <section class="border-b border-rule bg-paper" aria-labelledby="yaklasim">
    <div class="wrap grid grid-cols-1 gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-4">
        <h2 id="yaklasim" class="h2">Önleyici hukuk, sürekli danışmanlık.</h2>
        <Photo
          src={betonCephe}
          alt="Tekrarlayan modüler beton cephe dokusu"
          aspect="aspect-[4/5]"
          sizes="(min-width: 768px) 30vw, 100vw"
          class="mt-12 hidden md:block"
        />
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink md:col-span-7 md:col-start-6">
        <p>
          1996 yılında Bursa'da kurulan büromuz, kentin sanayi, üretim, ticaret ve hizmet sektörlerinde faaliyet
          gösteren müvekkillerine uzun soluklu bir çalışma ilişkisi içinde hizmet vermektedir.
        </p>
        <p class="text-slate">
          Çalışmalarımızın merkezinde önleyici hukuk prensibi yer alır: Uyuşmazlık doğduktan sonra müdahale etmek
          yerine, sözleşme ve kurumsal süreçleri baştan sağlam kurarak hukuki riskleri öngörmek ve yönetmek.
          Müvekkillerimizin faaliyetlerini yakından tanıyan sürekli danışmanlık modeli, hukuki değerlendirmelerin
          işletmenin ticari gerçekliğiyle uyumlu olmasını sağlar.
        </p>
        <div class="pt-4">
          <a href="/hakkimizda" class="link-arrow">Büromuz hakkında</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Çalışma Alanları Dizini -->
  <section aria-labelledby="alanlar">
    <div class="wrap grid grid-cols-1 gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-3">
        <h2 id="alanlar" class="h2">Çalışma alanları</h2>
      </div>
      <div class="md:col-span-9">
        <PracticeIndex />
      </div>
    </div>
  </section>

  <!-- İlk görüşme süreci -->
  <div class="border-t border-rule">
    <div class="wrap grid grid-cols-1 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-8 md:col-start-5">
        <GorusmeSureci />
      </div>
    </div>
  </div>

  <!-- Görüşme talebi -->
  <section class="bg-navy text-bone" aria-labelledby="gorusme-cta">
    <div class="wrap grid grid-cols-1 gap-10 py-20 md:grid-cols-12 md:items-end md:py-24">
      <div class="md:col-span-6">
        <h2 id="gorusme-cta" class="font-serif text-[clamp(2rem,3.4vw,3rem)] leading-tight tracking-(--tracking-display) text-bone">
          Görüşme talebi
        </h2>
        <p class="mt-4 max-w-md text-bone/70">
          Konunuzu kısaca iletin; ön bilgi aşamasının ardından randevu için size dönüş yapılır.
        </p>
      </div>
      <div class="md:col-span-6 md:justify-self-end">
        <GorusmeButonlari tone="dark" />
        <p class="mt-6 text-sm text-bone/60">{site.address.full} · {site.hours.display}</p>
      </div>
    </div>
  </section>
</Layout>
