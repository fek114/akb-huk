---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sayfa bulunamadı">
  <section class="wrap grid grid-cols-1 gap-8 py-32 md:grid-cols-12 md:py-48">
    <p class="label md:col-span-3">404</p>
    <div class="md:col-span-8 md:col-start-5">
      <h1 class="display">Aradığınız sayfa bulunamadı.</h1>
      <p class="lead mt-8">Sayfa taşınmış veya kaldırılmış olabilir.</p>
      <a href="/" class="link-arrow mt-12">Ana sayfaya dön</a>
    </div>
  </section>
</Layout>
