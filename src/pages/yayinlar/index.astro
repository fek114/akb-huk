---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import YayinList from '../../components/YayinList.astro';
import { getYayinlar } from '../../lib/yayinlar';

const yayinlar = await getYayinlar();
---

<Layout
  title="Yayınlar"
  description="Akbulut Hukuk Bürosu tarafından hazırlanan hukuki bültenler, makaleler ve mevzuat notları."
>
  <PageHeader
    label="Yayınlar"
    title="Hukuki Bültenler ve Değerlendirmeler"
    lead="Mevzuat ve yargı uygulamasındaki gelişmelere ilişkin genel bilgilendirme amaçlı değerlendirmelerimiz."
  />
  <section class="wrap py-20 md:py-28">
    <YayinList items={yayinlar} />
  </section>
</Layout>
