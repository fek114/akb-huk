---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactBlock from '../components/contact/ContactBlock.astro';
import ContactChannels from '../components/contact/ContactChannels.astro';
import GorusmeSureci from '../components/GorusmeSureci.astro';
---

<Layout title="İletişim" description="Akbulut Hukuk Bürosu iletişim bilgileri, görüşme talebi, adres ve çalışma saatleri.">
  <PageHeader label="İletişim" title="Büromuz" />

  <section class="wrap grid grid-cols-1 gap-16 py-20 md:grid-cols-12 md:py-28">
    <div class="md:col-span-7">
      <ContactChannels />
    </div>

    <aside class="text-sm text-slate md:col-span-4 md:col-start-9">
      <p>
        Görüşmeler randevu ile yapılmaktadır. İlk iletişimde belge veya ayrıntılı bilgi göndermemenizi rica ederiz;
        gerekli belgeler randevu aşamasında birlikte belirlenir.
      </p>
      <p class="mt-6 border-t border-rule pt-6">
        WhatsApp üzerinden ilettiğiniz mesajlar da dâhil olmak üzere kişisel verilerinizin işlenmesine ilişkin bilgi
        için <a href="/kvkk" class="link">KVKK Aydınlatma Metni</a>'ni inceleyebilirsiniz.
      </p>
    </aside>
  </section>

  <section class="border-t border-rule" aria-label="İletişim bilgileri">
    <div class="wrap grid grid-cols-1 gap-10 py-20 md:grid-cols-12 md:py-24">
      <h2 class="h2 md:col-span-4">Adres ve saatler</h2>
      <div class="md:col-span-7 md:col-start-6">
        <ContactBlock />
      </div>
    </div>
  </section>

  <div class="border-t border-rule bg-paper">
    <div class="wrap grid grid-cols-1 py-24 md:grid-cols-12 md:py-28">
      <div class="md:col-span-8 md:col-start-5">
        <GorusmeSureci />
      </div>
    </div>
  </div>
</Layout>
