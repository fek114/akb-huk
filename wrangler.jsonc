{
  // Cloudflare Workers — statik site (Astro `dist/`) + ön bilgilendirme asistanı
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akbulut-hukuk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Yalnızca /api/* isteklerinde Worker kodu çalışır; diğer her şey doğrudan statik dosyadır.
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // Asistan kötüye kullanım sınırı: IP başına dakikada 8 mesaj
  "ratelimits": [
    { "name": "ASISTAN_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ],
  "vars": {
    // Model değiştirmek için: npx wrangler ai models
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // "false" yapılırsa API kapanır (panel de ayarlardan kapatılmalı)
    "ASISTAN_ENABLED": "true"
  },
  // Konuşma içerikleri loglanmaz; yalnızca hata kayıtları için açık.
  "observability": { "enabled": false }
}
